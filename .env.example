# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://nscomzzptpjmqlqbwsmu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sSaB1_ISOh2LqYx1QG1YGQ_EJ-Qp-__

# Default company id (Vista Group seed)
NEXT_PUBLIC_DEFAULT_COMPANY_ID=96f6b539-b491-4df7-91a2-80c7c8e7491d

# WhatsApp (Meta Cloud API) — for transport booking confirmations
# Create a WhatsApp app at business.facebook.com, add a phone number, and generate
# a permanent System User token. WHATSAPP_PHONE_NUMBER_ID is the number's *id*.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional:
# WHATSAPP_API_VERSION=v21.0
# For business-initiated messages (outside the 24h window) Meta REQUIRES an
# approved template. Set its name here to send as a template ({{1}} = the body):
# WHATSAPP_TEMPLATE=booking_confirmation
# WHATSAPP_TEMPLATE_LANG=en

# Web Push (phone / desktop notifications)
# The public key has a built-in default and ships in the browser bundle; the
# PRIVATE key has no default, and without it /api/push/dispatch reaches its body
# and returns skipped:"VAPID not configured" without sending anything. Generate a
# pair with:  npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # optional — only to replace the built-in pair
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@vista-group.co

# Scheduled jobs (/api/cron/*)
# REQUIRED. These endpoints run outside staff auth — the scheduler has no
# Supabase session — so this secret is the only thing in front of a job that
# generates charges, posts to the ledger and raises notifications. With it unset
# the routes refuse (503) rather than accept anonymous callers. Vercel passes it
# automatically as a Bearer token once the variable exists on the project.
CRON_SECRET=
