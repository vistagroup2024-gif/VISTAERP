# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://nscomzzptpjmqlqbwsmu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sSaB1_ISOh2LqYx1QG1YGQ_EJ-Qp-__

# Default company id (Vista Group seed)
NEXT_PUBLIC_DEFAULT_COMPANY_ID=96f6b539-b491-4df7-91a2-80c7c8e7491d

# WhatsApp (Meta Cloud API) — for transport booking confirmations
# Create a WhatsApp app at business.facebook.com, add a phone number, and generate
# a permanent System User token. WHATSAPP_PHONE_NUMBER_ID is the number's *id*.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional:
# WHATSAPP_API_VERSION=v21.0
# For business-initiated messages (outside the 24h window) Meta REQUIRES an
# approved template. Set its name here to send as a template ({{1}} = the body):
# WHATSAPP_TEMPLATE=booking_confirmation
# WHATSAPP_TEMPLATE_LANG=en

# Vista AI (Anthropic Messages API) — server-side only, never exposed to the browser.
# Create a key at console.anthropic.com and set it in Vercel → Project → Settings →
# Environment Variables. Without it Vista AI renders but says she is not configured.
ANTHROPIC_API_KEY=

# Claude Code bridge — how Vista AI hands an approved development task over.
# A fine-grained GitHub PAT scoped to THIS REPOSITORY ONLY, with Issues and
# Pull requests read/write. Do NOT grant the workflow scope: Vista AI must not
# be able to dispatch a deploy. It cannot merge either — production is reached
# only by a person merging the pull request on GitHub.
GITHUB_TOKEN=
GITHUB_REPO=vistagroup2024-gif/VISTAERP
